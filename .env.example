# ConcursoOS - Variáveis de Ambiente (Template de Exemplo)

# Modo de Execução: 'local' (SQLite nativo offline) ou 'supabase' (nuvem)
NEXT_PUBLIC_DATABASE_MODE=local
LOCAL_DB_PATH=./data/concurso.db

# Supabase (Opcional - necessário apenas se NEXT_PUBLIC_DATABASE_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Provedor de IA (Google Gemini - Opcional para estruturação de editais por IA)
GOOGLE_AI_MODEL=gemini-1.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=sua-chave-api-gemini

# Configurações do App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
